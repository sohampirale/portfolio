---
/**
 * ChatWidget
 *
 * Floating AI chatbot for the portfolio.
 * Matches the Case portfolio minimal dark design system.
 *
 * Calls /api/chat server-side (Fireworks DeepSeek V4 Flash + Exa agent).
 *
 * @component
 */
---

<!-- Chat Toggle Button -->
<button
  id="chat-toggle-btn"
  aria-label="Ask AI about Soham"
  title="Ask anything about Soham"
>
  <svg id="chat-icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display:none">
    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
  </svg>
  <svg id="chat-icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <line x1="18" y1="6" x2="6" y2="18"></line>
    <line x1="6" y1="6" x2="18" y2="18"></line>
  </svg>
</button>

<!-- Chat Panel — Open by default -->
<div id="chat-panel" aria-label="Chat with Soham's AI" role="dialog" aria-modal="true" style="display:flex">
  <!-- Header -->
  <div class="chat-header">
    <div class="chat-header-info">
      <span class="chat-avatar">SP</span>
      <div>
        <p class="chat-name">Soham's AI Copilot</p>
        <p class="chat-status">Ask anything about Soham</p>
      </div>
    </div>
    <button id="chat-close-btn" aria-label="Close chat" type="button">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" width="18" height="18">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Messages Area -->
  <div id="chat-messages" role="log" aria-live="polite">
    <div class="chat-msg assistant">
      <div class="msg-sender-label">Soham's AI</div>
      <p>Hi! Ask me anything about Soham — his products (RopMitra, AquaTrack), AI agent architecture, tech stack, or engineering trade-offs.</p>
    </div>
  </div>

  <!-- Suggested Starters -->
  <div id="chat-starters">
    <button class="starter-chip" data-msg="What products has Soham built?" type="button">Products built</button>
    <button class="starter-chip" data-msg="Tell me about RopMitra" type="button">RopMitra SaaS</button>
    <button class="starter-chip" data-msg="What is Soham's tech stack?" type="button">Tech stack</button>
    <button class="starter-chip" data-msg="What are his AI agent projects?" type="button">AI agent work</button>
  </div>

  <!-- Input Form -->
  <form id="chat-form">
    <input
      id="chat-input"
      type="text"
      placeholder="Ask about Soham..."
      autocomplete="off"
      maxlength="500"
      required
    />
    <button type="submit" id="chat-send-btn" aria-label="Send message">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
        <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/>
      </svg>
    </button>
  </form>
</div>

<style>
  /* ─── Toggle Button (Case Theme Native) ───────────────────────────────── */
  #chat-toggle-btn {
    position: fixed;
    bottom: 1.75rem;
    right: 1.75rem;
    z-index: 1000;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--color-text, #e5e5e5);
    color: var(--color-bg, #0a0a0a);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #chat-toggle-btn:hover {
    transform: scale(1.06);
    box-shadow: 0 6px 28px rgba(0, 0, 0, 0.7);
  }

  #chat-toggle-btn svg {
    width: 1.25rem;
    height: 1.25rem;
    pointer-events: none;
  }

  /* ─── Chat Panel (Minimal Dark Aesthetic) ────────────────────────────── */
  #chat-panel {
    position: fixed;
    bottom: 5.75rem;
    right: 1.75rem;
    z-index: 999;
    width: 26rem;
    max-width: calc(100vw - 2rem);
    height: 34rem;
    max-height: calc(85vh - 4rem);
    display: flex;
    flex-direction: column;
    background: var(--color-bg-secondary, #111111);
    border: 1px solid var(--color-border, #262626);
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.7);
    overflow: hidden;
    animation: slideUp 0.2s ease;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ─── Header ─────────────────────────────────────────────────────────── */
  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.125rem;
    border-bottom: 1px solid var(--color-border, #262626);
    background: var(--color-bg, #0a0a0a);
    flex-shrink: 0;
  }

  .chat-header-info {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .chat-avatar {
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--color-text, #e5e5e5);
    color: var(--color-bg, #0a0a0a);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    flex-shrink: 0;
  }

  .chat-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text, #e5e5e5);
    margin: 0;
    line-height: 1.2;
  }

  .chat-status {
    font-size: 0.7rem;
    color: var(--color-text-muted, #737373);
    margin: 0;
    line-height: 1.2;
    margin-top: 0.15rem;
  }

  #chat-close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-text-muted, #737373);
    padding: 0.5rem;
    margin: -0.25rem;
    border-radius: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: color 0.15s, background 0.15s;
    position: relative;
    z-index: 10;
    pointer-events: auto;
  }

  #chat-close-btn:hover {
    color: var(--color-text, #e5e5e5);
    background: var(--color-bg-elevated, #1a1a1a);
  }

  #chat-close-btn svg {
    pointer-events: none;
  }

  /* ─── Messages Area ──────────────────────────────────────────────────── */
  #chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border, #262626) transparent;
  }

  .msg-sender-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    margin-bottom: 0.25rem;
  }

  .chat-msg {
    max-width: 86%;
    font-size: 0.875rem;
    line-height: 1.55;
    padding: 0.65rem 0.9rem;
    border-radius: 8px;
    animation: fadeIn 0.15s ease;
    word-break: break-word;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* User Message Bubble — High Contrast White */
  .chat-msg.user {
    align-self: flex-end;
    background: var(--color-text, #e5e5e5);
    color: var(--color-bg, #0a0a0a) !important;
    border-bottom-right-radius: 2px;
  }

  .chat-msg.user .msg-sender-label {
    color: #555555 !important;
    text-align: right;
  }

  .chat-msg.user p,
  .chat-msg.user strong,
  .chat-msg.user span {
    color: var(--color-bg, #0a0a0a) !important;
  }

  /* Assistant Message Bubble — Sleek Dark Card */
  .chat-msg.assistant {
    align-self: flex-start;
    background: var(--color-bg-elevated, #1a1a1a);
    color: var(--color-text, #e5e5e5) !important;
    border: 1px solid var(--color-border, #262626);
    border-bottom-left-radius: 2px;
  }

  .chat-msg.assistant .msg-sender-label {
    color: var(--color-text-secondary, #a3a3a3) !important;
  }

  .chat-msg.assistant p {
    margin: 0 0 0.35rem;
    color: var(--color-text, #e5e5e5);
  }

  .chat-msg.assistant p:last-child {
    margin-bottom: 0;
  }

  .chat-msg.assistant strong {
    color: #ffffff;
  }

  .chat-msg.assistant .exa-badge {
    display: inline-block;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary, #a3a3a3);
    border: 1px solid var(--color-border, #262626);
    padding: 0.125rem 0.375rem;
    border-radius: 3px;
    margin-top: 0.375rem;
  }

  /* Typing Indicator */
  .chat-msg.typing {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.75rem 1rem;
  }

  .typing-dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-text-muted, #737373);
    animation: typingPulse 1.2s ease-in-out infinite;
  }

  .typing-dot:nth-child(2) { animation-delay: 0.2s; }
  .typing-dot:nth-child(3) { animation-delay: 0.4s; }

  @keyframes typingPulse {
    0%, 60%, 100% { opacity: 0.3; transform: scale(0.8); }
    30%           { opacity: 1;   transform: scale(1); }
  }

  /* ─── Starter Chips ──────────────────────────────────────────────────── */
  #chat-starters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    padding: 0 1rem 0.75rem;
    flex-shrink: 0;
  }

  .starter-chip {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.3rem 0.625rem;
    border-radius: 999px;
    border: 1px solid var(--color-border, #262626);
    background: transparent;
    color: var(--color-text-secondary, #a3a3a3);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
    white-space: nowrap;
  }

  .starter-chip:hover {
    border-color: var(--color-text-muted, #737373);
    color: var(--color-text, #e5e5e5);
    background: var(--color-bg-elevated, #1a1a1a);
  }

  /* ─── Input Form ─────────────────────────────────────────────────────── */
  #chat-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--color-border, #262626);
    flex-shrink: 0;
    background: var(--color-bg, #0a0a0a);
  }

  #chat-input {
    flex: 1;
    background: var(--color-bg-secondary, #111111);
    border: 1px solid var(--color-border, #262626);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--color-text, #e5e5e5);
    outline: none;
    transition: border-color 0.15s;
    font-family: inherit;
  }

  #chat-input::placeholder {
    color: var(--color-text-muted, #555555);
  }

  #chat-input:focus {
    border-color: var(--color-text-muted, #737373);
  }

  #chat-send-btn {
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 6px;
    border: none;
    background: var(--color-text, #e5e5e5);
    color: var(--color-bg, #0a0a0a);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.15s;
  }

  #chat-send-btn:hover { opacity: 0.85; }
  #chat-send-btn:disabled { opacity: 0.4; cursor: not-allowed; }

  /* ─── Mobile ──────────────────────────────────────────────────────────── */
  @media (max-width: 480px) {
    #chat-panel {
      right: 0.75rem;
      left: 0.75rem;
      width: auto;
      bottom: 5.25rem;
      height: 75vh;
    }
    #chat-toggle-btn {
      right: 1rem;
      bottom: 1.25rem;
    }
  }
</style>

<script>
  // Conversation state
  let conversationHistory: { role: string; content: string }[] = [];
  let isOpen = true; // Open by default
  let isLoading = false;

  function initChat() {
    const toggleBtn    = document.getElementById('chat-toggle-btn');
    const closeBtn     = document.getElementById('chat-close-btn');
    const panel        = document.getElementById('chat-panel');
    const form         = document.getElementById('chat-form') as HTMLFormElement | null;
    const input        = document.getElementById('chat-input') as HTMLInputElement | null;
    const messagesDiv  = document.getElementById('chat-messages');
    const startersDiv  = document.getElementById('chat-starters');
    const openIcon     = document.getElementById('chat-icon-open');
    const closeIcon    = document.getElementById('chat-icon-close');
    const sendBtn      = document.getElementById('chat-send-btn') as HTMLButtonElement | null;

    if (!panel || !toggleBtn || !closeBtn) return;

    function openChat(e?: Event) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      if (panel && openIcon && closeIcon) {
        panel.style.display = 'flex';
        openIcon.style.display = 'none';
        closeIcon.style.display = 'block';
        isOpen = true;
      }
    }

    function closeChat(e?: Event) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }
      if (panel && openIcon && closeIcon) {
        panel.style.display = 'none';
        openIcon.style.display = 'block';
        closeIcon.style.display = 'none';
        isOpen = false;
      }
    }

    // Toggle button click & touch handlers
    toggleBtn.onclick = (e) => {
      if (isOpen) {
        closeChat(e);
      } else {
        openChat(e);
      }
    };

    // Close button explicit handlers
    closeBtn.onclick = (e) => closeChat(e);

    // Add message bubble
    function addMessage(role: 'user' | 'assistant', content: string, usedExa = false) {
      if (!messagesDiv) return;
      const div = document.createElement('div');
      div.className = `chat-msg ${role}`;

      const senderLabel = role === 'user' ? 'You' : "Soham's AI";

      const formatted = content
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        .replace(/\*(.*?)\*/g, '<em>$1</em>')
        .replace(/`([^`]+)`/g, '<code style="background:rgba(255,255,255,0.08);padding:0.1em 0.3em;border-radius:3px;font-size:0.85em">$1</code>')
        .split('\n\n')
        .map((para: string) => `<p>${para.replace(/\n/g, '<br>')}</p>`)
        .join('');

      div.innerHTML = `<div class="msg-sender-label">${senderLabel}</div>${formatted}`;

      if (usedExa && role === 'assistant') {
        const badge = document.createElement('span');
        badge.className = 'exa-badge';
        badge.textContent = '⚡ Web Search Used';
        div.appendChild(badge);
      }

      messagesDiv.appendChild(div);
      messagesDiv.scrollTop = messagesDiv.scrollHeight;
    }

    function showTyping(): HTMLElement | null {
      if (!messagesDiv) return null;
      const div = document.createElement('div');
      div.className = 'chat-msg assistant typing';
      div.id = 'typing-indicator';
      div.innerHTML = `
        <div class="msg-sender-label">Soham's AI</div>
        <div style="display:flex;gap:0.3rem;align-items:center">
          <span class="typing-dot"></span>
          <span class="typing-dot"></span>
          <span class="typing-dot"></span>
        </div>
      `;
      messagesDiv.appendChild(div);
      messagesDiv.scrollTop = messagesDiv.scrollHeight;
      return div;
    }

    function removeTyping() {
      document.getElementById('typing-indicator')?.remove();
    }

    async function sendMessage(text: string) {
      if (!text.trim() || isLoading) return;

      if (startersDiv) startersDiv.style.display = 'none';

      addMessage('user', text);
      conversationHistory.push({ role: 'user', content: text });

      isLoading = true;
      if (sendBtn) sendBtn.disabled = true;
      if (input) {
        input.value = '';
        input.disabled = true;
      }

      showTyping();

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: text, history: conversationHistory.slice(-12) }),
        });

        removeTyping();

        if (!res.ok) {
          const err = await res.json().catch(() => ({ error: 'Unknown error' }));
          addMessage('assistant', err.error || 'Something went wrong. Please try again.');
          return;
        }

        const data = await res.json();
        const reply: string = data.reply || 'Sorry, I couldn\'t generate a response.';
        const usedExa: boolean = data.usedExa || false;

        addMessage('assistant', reply, usedExa);
        conversationHistory.push({ role: 'assistant', content: reply });

      } catch {
        removeTyping();
        addMessage('assistant', 'Network error. Please check your connection and try again.');
      } finally {
        isLoading = false;
        if (sendBtn) sendBtn.disabled = false;
        if (input) {
          input.disabled = false;
          input.focus();
        }
      }
    }

    if (form) {
      form.onsubmit = (e) => {
        e.preventDefault();
        if (input) sendMessage(input.value.trim());
      };
    }

    document.querySelectorAll('.starter-chip').forEach((chip) => {
      (chip as HTMLElement).onclick = () => {
        const msg = (chip as HTMLElement).dataset.msg || '';
        sendMessage(msg);
      };
    });
  }

  // Bind on both initial load and View Transitions (ClientRouter)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChat);
  } else {
    initChat();
  }

  document.addEventListener('astro:page-load', initChat);

  // Global delegated click listener for close button fallback
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (target && target.closest && target.closest('#chat-close-btn')) {
      const panel = document.getElementById('chat-panel');
      const openIcon = document.getElementById('chat-icon-open');
      const closeIcon = document.getElementById('chat-icon-close');
      if (panel && openIcon && closeIcon) {
        panel.style.display = 'none';
        openIcon.style.display = 'block';
        closeIcon.style.display = 'none';
      }
    }
  });
</script>
