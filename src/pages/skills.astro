---
/**
 * Skills Page — Soham Pirale
 *
 * In-depth technical skills inventory, framework proficiency,
 * database mastery, AI engineering stack, and architectural capabilities.
 *
 * Designed to match the clean, minimal aesthetic of the Case portfolio theme.
 *
 * Route: /skills
 * @page
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';

const pageTitle = "Technical Skills & Engineering Stack | Soham Pirale";
const pageDescription = "Comprehensive inventory of Soham Pirale's engineering skills across AI systems, backend architecture, databases, vertical SaaS automation, frontend frameworks, and cloud infrastructure.";

// Categorized skill inventory (no generic icons)
const skillCategories = [
  {
    id: "ai-engineering",
    categoryCode: "01",
    title: "AI Engineering & Autonomous Agents",
    description: "Production-grade cyclic state agents, neural search platforms, RAG pipelines, and voice interfaces.",
    skills: [
      { name: "LangGraph", level: "Expert", desc: "Cyclic state graphs, validation loops, persistent memory, and agentic workflows" },
      { name: "DeepSeek & Fireworks AI", level: "Expert", desc: "DeepSeek V4 Flash / V3 inference, low-latency API integration, system prompting" },
      { name: "Exa AI Neural Search", level: "Expert", desc: "Agentic web research tool calling, alumni indexing, and real-time internet retrieval" },
      { name: "LangChain", level: "Advanced", desc: "Chain construction, prompt templates, output parsers, and tool abstraction" },
      { name: "RAG & Embeddings", level: "Advanced", desc: "Vector indexing, Cohere & Google embeddings, semantic retrieval, hybrid search" },
      { name: "Tool Calling & Function Execution", level: "Expert", desc: "Schema validation, structured outputs, multi-tool orchestration" },
      { name: "Voice AI & Pipecat", level: "Intermediate", desc: "Pipecat framework, voice cloning (MeetMyClone), meeting bot automation" },
      { name: "OpenAI, Claude & Gemini", level: "Expert", desc: "Multi-provider LLM orchestration, fallback strategies, token optimization" },
    ]
  },
  {
    id: "backend-systems",
    categoryCode: "02",
    title: "Backend & Distributed Systems",
    description: "Low-latency APIs, event-driven webhooks, custom workflow engines, and background execution queues.",
    skills: [
      { name: "Node.js & Express", level: "Expert", desc: "REST APIs, custom middleware, stream processing, asynchronous pipelines" },
      { name: "TypeScript", level: "Expert", desc: "Strict type safety, generic utilities, backend & frontend unified typing" },
      { name: "Socket.io & WebSockets", level: "Expert", desc: "Real-time terminal streaming (DockHostV2), multi-worker node heartbeat & reconnection" },
      { name: "Python", level: "Advanced", desc: "LangGraph agents, script automation, data processing, voice frameworks" },
      { name: "Hono & Edge Runtimes", level: "Advanced", desc: "Ultra-fast serverless API routes on Cloudflare Workers and Node" },
      { name: "Authentication Systems", level: "Advanced", desc: "BetterAuth, NextAuth, JWT session security, OAuth2 providers" },
      { name: "Background Queue Architecture", level: "Expert", desc: "SQLite WAL-mode queues for low-RAM VMs, Redis job queues, cron workers" },
    ]
  },
  {
    id: "databases-storage",
    categoryCode: "03",
    title: "Databases & Storage Infrastructure",
    description: "Relational, document, vector, and embedded databases optimized for constrained resources.",
    skills: [
      { name: "PostgreSQL & Neon", level: "Advanced", desc: "Relational modeling, indexing, Prisma & Drizzle ORM, serverless Postgres" },
      { name: "SQLite (better-sqlite3)", level: "Expert", desc: "Embedded WAL mode queues, zero-daemon persistence, ultra-low RAM footprint (<80MB)" },
      { name: "MongoDB & Mongoose", level: "Advanced", desc: "Document schemas, aggregation pipelines, replica set management" },
      { name: "Supabase", level: "Advanced", desc: "Postgres database, real-time subscriptions, storage buckets, Auth" },
      { name: "Qdrant Vector DB", level: "Advanced", desc: "Vector similarity search, collection payload filtering, semantic retrieval" },
      { name: "Cloudflare D1 & KV", level: "Advanced", desc: "Edge SQL database and global key-value cache" },
      { name: "Prisma & Drizzle ORM", level: "Expert", desc: "Type-safe database migrations, schema generation, complex joins" },
    ]
  },
  {
    id: "automation-saas",
    categoryCode: "04",
    title: "Automation & Vertical SaaS Systems",
    description: "Zero-to-one SaaS applications for nurseries, water purifier service companies, and custom workflow engines.",
    skills: [
      { name: "n8n Custom Workflow Engine", level: "Expert", desc: "Built full visual drag-and-drop n8n clone from scratch with custom nodes" },
      { name: "WhatsApp Automation", level: "Expert", desc: "Evolution API, Baileys, WAHA, campaign queueing, Marathi PDF invoice delivery" },
      { name: "Telegram Bot Platform", level: "Advanced", desc: "Custom bot triggers, webhooks, broadcast automation" },
      { name: "Twilio API", level: "Advanced", desc: "SMS/WhatsApp subaccounts, multi-tenant per-customer number billing" },
      { name: "Playwright Web Scraping", level: "Advanced", desc: "Headless browser automation, Playwright-MCP agent integration" },
      { name: "Buffer API Integration", level: "Advanced", desc: "Autonomous social content scheduling & shadow-mode approval pipeline" },
    ]
  },
  {
    id: "frontend-ui",
    categoryCode: "05",
    title: "Frontend & UI Engineering",
    description: "Responsive, high-performance web applications with clean design systems and modern frameworks.",
    skills: [
      { name: "React 18 & Next.js", level: "Expert", desc: "App Router, Server Components, SSR/SSG, state management, custom hooks" },
      { name: "Astro 5", level: "Expert", desc: "Content Collections, hybrid SSR/SSG mode, zero-JS default output" },
      { name: "Vite & Vanilla JS", level: "Expert", desc: "Custom component development, ES modules, lightweight UI widgets" },
      { name: "Tailwind CSS & shadcn/ui", level: "Expert", desc: "Design systems, dark modes, glassmorphism, responsive utility layouts" },
      { name: "HTML5 & Modern CSS", level: "Expert", desc: "Semantic markup, CSS Grid/Flexbox, micro-animations, accessibility" },
    ]
  },
  {
    id: "devops-infrastructure",
    categoryCode: "06",
    title: "DevOps & Cloud Infrastructure",
    description: "Containerization, cloud VM management, reverse proxies, and continuous integration pipelines.",
    skills: [
      { name: "Docker & Docker Compose", level: "Expert", desc: "Multi-stage builds, container isolation, persistent volumes, DockHost orchestration" },
      { name: "Linux (Ubuntu Server)", level: "Expert", desc: "Bash scripting, systemd service management, process monitoring (PM2), SSH security" },
      { name: "Oracle Cloud Infrastructure (OCI)", level: "Advanced", desc: "Always Free ARM VMs, Virtual Cloud Networks (VCN), subnets, NAT gateways" },
      { name: "Nginx", level: "Advanced", desc: "Reverse proxying, SSL/TLS setup (Certbot), load balancing, WebSocket proxying" },
      { name: "Vercel & Cloudflare", level: "Expert", desc: "Serverless deployments, domain aliasing, edge functions, DNS configuration" },
      { name: "GitHub Actions & CI/CD", level: "Advanced", desc: "Automated test runs, build validation, deployment pipelines" },
    ]
  },
  {
    id: "languages-foundations",
    categoryCode: "07",
    title: "Core Languages & Fundamentals",
    description: "Foundational programming languages, data structures, and computer science principles.",
    skills: [
      { name: "TypeScript / JavaScript", level: "Primary", desc: "Daily primary language across frontend, backend, serverless, and AI systems" },
      { name: "Python", level: "Secondary", desc: "AI agent engineering, automation scripts, voice pipelines" },
      { name: "SQL", level: "Advanced", desc: "Complex queries, indexing strategies, join optimization, schema design" },
      { name: "C & C++", level: "Foundational", desc: "Data structures, memory management algorithms, systems programming" },
      { name: "Java", level: "Foundational", desc: "Object-oriented programming concepts, core data structures" },
      { name: "Bash & Shell Scripting", level: "Advanced", desc: "System administration scripts, server deployment automation" },
    ]
  }
];
---

<BaseLayout>
  <SEO
    title={pageTitle}
    description={pageDescription}
  />

  <div class="skills-container">
    <header class="skills-header">
      <h1 class="skills-title">Technical Skills & Stack</h1>
      <p class="skills-subtitle">
        A structured breakdown of every technology, framework, database, AI framework, and infrastructure tool I build with.
      </p>
    </header>

    <!-- Quick Navigation Bar -->
    <nav class="skills-nav" aria-label="Skills sections">
      {skillCategories.map((cat) => (
        <a href={`#${cat.id}`} class="skills-nav-item">
          <span class="nav-code">{cat.categoryCode}</span>
          <span>{cat.title.split(' ')[0]}</span>
        </a>
      ))}
    </nav>

    <!-- Skills Sections -->
    <div class="skills-sections">
      {skillCategories.map((category) => (
        <section id={category.id} class="skills-section">
          <div class="section-meta">
            <span class="section-number">{category.categoryCode}</span>
            <div class="section-title-group">
              <h2 class="section-title">{category.title}</h2>
              <p class="section-description">{category.description}</p>
            </div>
          </div>

          <div class="skills-grid">
            {category.skills.map((skill) => (
              <div class="skill-card">
                <div class="skill-head">
                  <h3 class="skill-name">{skill.name}</h3>
                  <span class="skill-badge">{skill.level}</span>
                </div>
                <p class="skill-desc">{skill.desc}</p>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .skills-container {
    max-width: var(--max-width-content, 1200px);
    margin: 0 auto;
    padding: var(--space-xl, 2rem) var(--space-md, 1rem) var(--space-4xl, 6rem);
  }

  .skills-header {
    margin-bottom: var(--space-2xl, 3rem);
    border-bottom: 1px solid var(--color-border, #262626);
    padding-bottom: var(--space-xl, 2rem);
  }

  .skills-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    color: var(--color-text, #e5e5e5);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-sm, 0.5rem);
  }

  .skills-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-secondary, #a3a3a3);
    max-width: 48ch;
    line-height: 1.6;
  }

  /* Quick Navigation */
  .skills-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--space-3xl, 4rem);
    padding: 0.5rem;
    background: var(--color-bg-secondary, #111111);
    border: 1px solid var(--color-border, #262626);
    border-radius: var(--border-radius-md, 0.5rem);
  }

  .skills-nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.4rem 0.75rem;
    border-radius: var(--border-radius-sm, 0.25rem);
    color: var(--color-text-secondary, #a3a3a3);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .skills-nav-item:hover {
    color: var(--color-text, #e5e5e5);
    background: var(--color-bg-elevated, #1a1a1a);
  }

  .nav-code {
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--color-text-muted, #737373);
  }

  /* Sections */
  .skills-section {
    margin-bottom: var(--space-3xl, 4rem);
    scroll-margin-top: 4rem;
  }

  .section-meta {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: var(--space-lg, 1.5rem);
  }

  .section-number {
    font-family: monospace;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted, #737373);
    padding-top: 0.25rem;
  }

  .section-title {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-text, #e5e5e5);
    margin: 0 0 0.25rem;
    letter-spacing: -0.01em;
  }

  .section-description {
    font-size: 0.875rem;
    color: var(--color-text-muted, #737373);
    margin: 0;
    line-height: 1.5;
  }

  /* Skills Grid */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }

  .skill-card {
    background: var(--color-bg-secondary, #111111);
    border: 1px solid var(--color-border, #262626);
    border-radius: var(--border-radius-md, 0.5rem);
    padding: 1.25rem;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .skill-card:hover {
    border-color: var(--color-text-muted, #555555);
    background: var(--color-bg-elevated, #1a1a1a);
  }

  .skill-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .skill-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text, #e5e5e5);
    margin: 0;
  }

  .skill-badge {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    background: var(--color-bg-elevated, #1a1a1a);
    color: var(--color-text-secondary, #a3a3a3);
    border: 1px solid var(--color-border, #262626);
  }

  .skill-desc {
    font-size: 0.8125rem;
    color: var(--color-text-muted, #737373);
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 640px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
